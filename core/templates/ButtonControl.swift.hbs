import AppIntents
import SwiftUI
import WidgetKit

// ─────────────────────────────────────────────────────────────────────────
//  📄  {{pascalCase id}}Control.swift   (Controls/{{pascalCase id}}Control.swift)
//  Button 컨트롤의 표시 정의 — 제어센터에 어떤 모양으로 보일지
//  (탭했을 때 일어나는 일은 Intents/{{pascalCase id}}Intent.swift 참조)
// ─────────────────────────────────────────────────────────────────────────

struct {{pascalCase id}}Control: ControlWidget {
    var body: some ControlWidgetConfiguration {
        {{#if parameterModel}}
        // 사용자 구성 컨트롤 — 추가 시 iOS가 설정 화면을 띄우고,
        // Provider가 고른 값(selection)을 여기로 넘겨 액션 인텐트에 주입한다.
        AppIntentControlConfiguration(
            kind: "{{bundleId}}.{{id}}",
            provider: {{pascalCase id}}Provider()
        ) { selection in
            ControlWidgetButton(action: {{pascalCase id}}Intent({{parameterModel.key}}: selection)) {
                Label("{{title}}", systemImage: "{{icon}}")
                {{#if tint}}
                    .tint(Color(hex: "{{tint}}"))
                {{/if}}
            }
        }
        .displayName("{{title}}")
        {{#if description}}
        .description("{{description}}")
        {{/if}}
        .promptsForUserConfiguration()
        {{else}}
        StaticControlConfiguration(
            kind: "{{bundleId}}.{{id}}"
        ) {
            ControlWidgetButton(action: {{pascalCase id}}Intent()) {
                Label("{{title}}", systemImage: "{{icon}}")
                {{#if tint}}
                    .tint(Color(hex: "{{tint}}"))
                {{/if}}
            }
        }
        .displayName("{{title}}")
        {{#if description}}
        .description("{{description}}")
        {{/if}}
        {{/if}}
    }
}
